{
  "schema": {
    "services": {
      "type": "list",
      "description": "Endereços monitorizados",
      "columns": [
        {
          "id": "name",
          "title": "Nome",
          "type": "string"
        },
        {
          "id": "target",
          "title": "URL / IP",
          "type": "string"
        },
        {
          "id": "mode",
          "title": "Modo",
          "type": "string",
          "options": {
            "HTTP": "http",
            "PING": "ping"
          },
          "default": "http"
        },
        {
          "id": "interval",
          "title": "Intervalo (segundos)",
          "type": "integer",
          "default": 30,
          "min": 5,
          "max": 86400
        }
      ],
      "default": [],
      "show-buttons": true
    },
    "tile-size": {
      "type": "spinbutton",
      "description": "Tamanho dos blocos",
      "default": 80,
      "min": 10,
      "max": 180,
      "step": 1,
      "units": "px"
    },
    "columns": {
      "type": "spinbutton",
      "description": "Número de colunas",
      "default": 3,
      "min": 1,
      "max": 8,
      "step": 1
    },
    "alarm-window": {
      "type": "switch",
      "description": "Alarme sempre visível",
      "default": true
    },
    "check-now": {
      "type": "button",
      "description": "Verificar agora",
      "callback": "checkNow"
    },
    "background-color": {
      "type": "combobox",
      "description": "Cor de fundo",
      "default": "dark",
      "options": {
        "Escuro": "dark",
        "Claro": "light",
        "Preto": "black",
        "Transparente": "transparent"
      }
    },
    "show-title": {
      "type": "switch",
      "description": "Mostrar título",
      "default": false
    },
    "tile-margin": {
      "type": "spinbutton",
      "description": "Margem da janela (px)",
      "default": 6,
      "min": 0,
      "max": 60,
      "step": 1,
      "units": "px"
    },
    "tile-gap": {
      "type": "spinbutton",
      "description": "Espaço entre blocos (px)",
      "default": 3,
      "min": 0,
      "max": 60,
      "step": 1,
      "units": "px"
    }
  },
  "ui": {
    "Service Monitor": "Monitor de serviços",
    "Right-click to add a service.": "Clique com o botão direito para adicionar um serviço.",
    "Add monitored service": "Adicionar serviço monitorizado",
    "Name": "Nome",
    "Check mode": "Modo de verificação",
    "Interval in seconds (min 5)": "Intervalo em segundos (mín. 5)",
    "Cancel": "Cancelar",
    "Add": "Adicionar",
    "Enter an address and interval between 5 and 86400 seconds.": "Introduza um endereço e intervalo entre 5 e 86400 segundos.",
    "Invalid HTTP/HTTPS address.": "Endereço HTTP/HTTPS inválido.",
    "Could not save: ": "Não foi possível guardar: ",
    "Not checked yet": "Ainda não verificado",
    "OK": "OK",
    "FAILED": "FALHA",
    "none": "nenhum",
    "Last result": "Último resultado",
    "Last check": "Última verificação"
  }
}
