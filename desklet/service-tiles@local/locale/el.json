{
  "schema": {
    "services": {
      "type": "list",
      "description": "Παρακολουθούμενες διευθύνσεις",
      "columns": [
        {
          "id": "name",
          "title": "Όνομα",
          "type": "string"
        },
        {
          "id": "target",
          "title": "URL / IP",
          "type": "string"
        },
        {
          "id": "mode",
          "title": "Λειτουργία",
          "type": "string",
          "options": {
            "HTTP": "http",
            "PING": "ping"
          },
          "default": "http"
        },
        {
          "id": "interval",
          "title": "Διάστημα (δευτερόλεπτα)",
          "type": "integer",
          "default": 30,
          "min": 5,
          "max": 86400
        }
      ],
      "default": [],
      "show-buttons": true
    },
    "tile-size": {
      "type": "spinbutton",
      "description": "Μέγεθος πλακιδίων",
      "default": 80,
      "min": 10,
      "max": 180,
      "step": 1,
      "units": "px"
    },
    "columns": {
      "type": "spinbutton",
      "description": "Αριθμός στηλών",
      "default": 3,
      "min": 1,
      "max": 8,
      "step": 1
    },
    "alarm-window": {
      "type": "switch",
      "description": "Ειδοποίηση πάντα μπροστά",
      "default": true
    },
    "check-now": {
      "type": "button",
      "description": "Έλεγχος τώρα",
      "callback": "checkNow"
    },
    "background-color": {
      "type": "combobox",
      "description": "Χρώμα φόντου",
      "default": "dark",
      "options": {
        "Σκούρο": "dark",
        "Ανοιχτό": "light",
        "Μαύρο": "black",
        "Διαφανές": "transparent"
      }
    },
    "show-title": {
      "type": "switch",
      "description": "Εμφάνιση τίτλου",
      "default": false
    },
    "tile-margin": {
      "type": "spinbutton",
      "description": "Περιθώριο παραθύρου (px)",
      "default": 6,
      "min": 0,
      "max": 60,
      "step": 1,
      "units": "px"
    },
    "tile-gap": {
      "type": "spinbutton",
      "description": "Απόσταση πλακιδίων (px)",
      "default": 3,
      "min": 0,
      "max": 60,
      "step": 1,
      "units": "px"
    }
  },
  "ui": {
    "Service Monitor": "Παρακολούθηση υπηρεσιών",
    "Right-click to add a service.": "Δεξί κλικ για προσθήκη υπηρεσίας.",
    "Add monitored service": "Προσθήκη υπηρεσίας",
    "Name": "Όνομα",
    "Check mode": "Λειτουργία ελέγχου",
    "Interval in seconds (min 5)": "Διάστημα σε δευτερόλεπτα (ελάχ. 5)",
    "Cancel": "Ακύρωση",
    "Add": "Προσθήκη",
    "Enter an address and interval between 5 and 86400 seconds.": "Εισάγετε διεύθυνση και διάστημα από 5 έως 86400 δευτερόλεπτα.",
    "Invalid HTTP/HTTPS address.": "Μη έγκυρη διεύθυνση HTTP/HTTPS.",
    "Could not save: ": "Αποτυχία αποθήκευσης: ",
    "Not checked yet": "Δεν έχει ελεγχθεί",
    "OK": "OK",
    "FAILED": "ΣΦΑΛΜΑ",
    "none": "κανένα",
    "Last result": "Τελευταίο αποτέλεσμα",
    "Last check": "Τελευταίος έλεγχος"
  }
}
